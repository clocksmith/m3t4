# Copy to .env.local for dev, set in Cloud Run / Firebase for prod.

# ---- Public config (safe to ship to client) ----
ARENA_API_ORIGIN=http://localhost:7777
ARENA_WS_ORIGIN=ws://localhost:7777

# Production values:
#   ARENA_API_ORIGIN=https://api.m3t4.ai
#   ARENA_WS_ORIGIN=wss://api.m3t4.ai

# Firebase (client SDK values — public by design)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=m3t4.ai
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Server-only (NEVER ship to client) ----
# Path to the GCP service account JSON (admin SDK)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Auth
# Local dev defaults to AUTH_MODE=dev; production must use firebase or
# alpha-token. AUTH_MODE=dev hard-fails under NODE_ENV=production.
NODE_ENV=development
AUTH_MODE=dev
M3T4_ALPHA_TOKEN=
M3T4_ALPHA_ALLOWLIST=
M3T4_INTERNAL_TOKEN=

# Cloud Run ports
PORT=7777

# Match cadence (ms) for firehose
CYCLE_MS=20000
WS_CLIENT_SOFT_LIMIT=0

# Submissions per slot per window
SUBMIT_RATE_MS=900000     # 15m
SUBMIT_IP_RATE_LIMIT_WINDOW_MS=600000
SUBMIT_IP_RATE_LIMIT_MAX=20

# Oauth provider allowlist (comma-separated)
AUTH_PROVIDERS=google,github

# Browser CORS allowlist. Production must be exactly https://m3t4.ai unless
# you intentionally add another deployed app origin.
CORS_ORIGINS=*

# Storage. Closed alpha can use file with max-instances=1; public beta uses
# firestore.
STORE_BACKEND=file
STORE_PATH=./server/data/m3t4.json

# ---- Optional surfaces (off for centralized beta unless explicitly enabled) ----
FEATURE_P2P_DUEL=false
FEATURE_COMMUNITY_VERIFY=false
FEATURE_PROOF_LAB=false
FEATURE_ZK=false
FEATURE_DISTRIBUTED_COMPUTE=false

# plasma-lab sidecar. Keep every switch off until deployed as an isolated
# service with separate IAM/storage.
FEATURE_COMPUTE_LAB_ROUTES=false
FEATURE_COMPUTE_TASK_ADMIN=false
FEATURE_COMPUTE_SLACK_WORKER=false
FEATURE_COMPUTE_WEBRTC_ARTIFACTS=false
FEATURE_COMPUTE_WEBRTC_SIGNALING=false
FEATURE_COMPUTE_WEBRTC_DATA=false
FEATURE_COMPUTE_WEBRTC_TURN=false
FEATURE_COMPUTE_RECEIPT_DASHBOARD=false
FEATURE_COMPUTE_LIVE_BADGES=false
FEATURE_COMPUTE_AUTO_SEED_REPLAY_TASKS=false
COMPUTE_ACCEPT_ASSIGNMENTS=false
COMPUTE_REQUIRE_RECEIPT_SIGNATURES=true
COMPUTE_LAB_ORIGIN=
# Optional comma-separated STUN URLs exposed to the opt-in browser witness.
COMPUTE_STUN_URLS=
# Optional TURN fallback. Keep disabled until cost and abuse limits are set.
COMPUTE_TURN_URLS=
COMPUTE_TURN_USERNAME=
COMPUTE_TURN_CREDENTIAL=
COMPUTE_ASSIGNMENT_TIMEOUT_MS=60000
COMPUTE_WORKER_SESSION_TTL_MS=3600000
COMPUTE_WEBRTC_SESSION_TTL_MS=600000
PLASMA_LAB_ADMIN_TOKEN=
# memory|firestore
PLASMA_LAB_STORE_BACKEND=memory
# Optional. Set to a separate compute project if you want stronger IAM isolation
# than same-project collection naming can provide.
PLASMA_LAB_FIRESTORE_PROJECT_ID=

# Required only when FEATURE_P2P_DUEL=true in production.
M3T4_MATCH_TOKEN_SECRET=

# Optional store overrides for non-central authority surfaces.
DUEL_STORE_PATH=
COMMUNITY_VERIFY_STORE_PATH=
PROOF_STORE_PATH=
