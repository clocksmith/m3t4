# Loaded automatically by `firebase deploy` for project m3ta-ai and
# exposed to the function as process.env.<KEY>. Used by webrtcSignal's
# `iceServers` op (see functions/src/webrtcSignal.ts:buildIceServers).
#
# Provider: Open Relay Project (metered.ca). Free tier = 50 GB/mo.
# Credentials are intentionally public — Open Relay shares the same
# username/password across every project using their free tier. WebRTC
# data channels are DTLS-encrypted, so the relay only ever sees
# ciphertext — sharing creds doesn't compromise data privacy. To swap
# providers (Cloudflare Realtime, Twilio, Xirsys, self-hosted coturn,
# etc.) replace the URLs and either keep TURN_USER/TURN_PASS for static
# auth or set TURN_SECRET for the time-windowed REST shape.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:80?transport=tcp,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
TURN_USER=openrelayproject
TURN_PASS=openrelayproject
ACTIVE_POOL_MS=43200000
CHAMPION_RELEASE_ENABLED=true
CHAMPION_FRONTIER_CANDIDATES=32
CHAMPION_FRONTIER_REFERENCES=16
CHAMPION_RELEASE_SLOTS=1
