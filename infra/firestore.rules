rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===== Match-engine collections (Functions architecture) =====
    //
    // Spectator-readable. Match docs contain stage/seed/actionLog/result
    // and intentionally exclude brain configs, so reads are safe.
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // Match-chain head + lock. Server-only. Read access is fine for
    // monitoring; writes are gated to Functions service account.
    match /state/{stateDoc} {
      allow read: if true;
      allow write: if false;
    }

    // WebRTC signaling: short-lived session docs. Anyone with the
    // sessionId can read/append candidates+offer+answer. Sessions
    // expire via TTL field; clients should respect expiresAt.
    match /webrtc/{sessionId} {
      allow read: if true;
      allow write: if false; // Writes go through webrtcSignal callable.
    }

    // ===== Stables (private brain configs) =====
    //
    // A signed-in user can read their OWN stable doc (for the profile
    // page). Writes always go through the submitStable callable so we
    // can validate brain configs and rate-limit per uid. No public read.
    match /stables/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ===== Spectator mesh presence =====
    //
    // Lightweight, ephemeral presence index. Each peer that wants to act
    // as a relay for matchId publishes an entry; new spectators read the
    // list to find a peer to connect to. Anyone can read; writes are
    // gated to authenticated users (or anon-auth tokens for unsigned
    // spectators) and self-scoped via the {peerId} path.
    match /meshSessions/{matchId}/peers/{peerId} {
      allow read: if true;
      allow create: if request.auth != null && peerId == request.auth.uid;
      allow update, delete: if request.auth != null && peerId == request.auth.uid;
    }

    // Handle uniqueness index. Also server-only because handle claims are
    // mediated by the claimHandle/submitStable callables.
    match /handles/{handle} {
      allow read, write: if false;
    }

    // Public projection. No bot configs, no private submission payloads.
    match /publicStables/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Flat public bot directory and append-only public bot arrival/update feed.
    // These docs are generated from stable slots and never include configs.
    match /publicBots/{botId} {
      allow read: if true;
      allow write: if false;
    }

    match /publicBotEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Public replay artifact summaries. These contain hashes and public player
    // refs only; full replay blobs and private configs remain closed below.
    match /publicReplayArtifacts/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // Full replay artifacts may include private configs. Spectators should
    // fetch sanitized tuples from /api/spectate/tuple/:matchId instead.
    match /replays/{matchId} {
      allow read, write: if false;
    }

    // Reserved if we later split replay blobs from match metadata.
    match /rankedMatches/{matchId} {
      allow read, write: if false;
    }

    // Optional verification/proof surfaces are off for beta and server-only
    // when enabled.
    match /duel/{doc=**} {
      allow read, write: if false;
    }
    match /community/{doc=**} {
      allow read, write: if false;
    }
    match /proof/{doc=**} {
      allow read, write: if false;
    }

    // plasma-lab sidecar state. Server-only; clients use plasma-lab HTTP
    // routes and never read/write coordinator state directly.
    match /compute_workers/{doc=**} {
      allow read, write: if false;
    }
    match /compute_capabilities/{doc=**} {
      allow read, write: if false;
    }
    match /compute_tasks/{doc=**} {
      allow read, write: if false;
    }
    match /compute_chunks/{doc=**} {
      allow read, write: if false;
    }
    match /compute_assignments/{doc=**} {
      allow read, write: if false;
    }
    match /compute_receipts/{doc=**} {
      allow read, write: if false;
    }
    match /compute_validations/{doc=**} {
      allow read, write: if false;
    }
    match /compute_reputation/{doc=**} {
      allow read, write: if false;
    }
    match /compute_artifact_exports/{doc=**} {
      allow read, write: if false;
    }
    match /compute_sessions/{doc=**} {
      allow read, write: if false;
    }
    match /compute_webrtc_sessions/{doc=**} {
      allow read, write: if false;
    }
    match /compute_webrtc_pairs/{doc=**} {
      allow read, write: if false;
    }
    match /compute_capability_observations/{doc=**} {
      allow read, write: if false;
    }
    match /compute_connectivity_observations/{doc=**} {
      allow read, write: if false;
    }
    match /compute_worker_profiles/{doc=**} {
      allow read, write: if false;
    }
    match /compute_device_classes/{doc=**} {
      allow read, write: if false;
    }
    match /compute_network_classes/{doc=**} {
      allow read, write: if false;
    }
    match /compute_public_stats/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // Firebase-native low-cost compute presence. Authenticated anonymous
    // or signed-in browsers publish only their own ephemeral peer entry;
    // assignment/receipt truth still goes through callables.
    match /compute_peer_presence/{peerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && peerId == request.auth.uid;
    }
    match /compute_replay_badges/{doc=**} {
      allow read, write: if false;
    }
  }
}
