{
  "name": "m3t4",
  "version": "0.1.0",
  "private": true,
  "description": "Meta Muzil: a simulated phone, teachable stand-ins, and a historical deterministic arena",
  "workspaces": [
    "sim",
    "match-engine",
    "server",
    "pareto",
    "plasma-lab",
    "functions"
  ],
  "scripts": {
    "sync:content": "node tools/sync-client-content.mjs",
    "sync:client-sim": "node tools/sync-client-sim.mjs",
    "check:content": "node tools/sync-client-content.mjs --check",
    "check:client-sim": "node tools/sync-client-sim.mjs --check",
    "prebuild": "npm run sync:content && npm run sync:runtime",
    "build": "npm -w sim run build && npm run sync:client-sim && npm -w match-engine run build && npm -w plasma-lab run build && npm -w functions run build",
    "build:legacy": "npm -w sim run build && npm run sync:client-sim && npm -w server run build && npm -w pareto run build && npm -w plasma-lab run build",
    "sim": "npm -w sim run cli --",
    "server": "npm -w server run start",
    "pareto": "npm -w pareto run sweep --",
    "plasma-lab": "npm -w plasma-lab run start",
    "phantom:gate": "npm -w pareto run phantom-gate --",
    "test:client": "node --test client/test/*.test.mjs",
    "test:ui": "node tools/browser-ui-smoke.mjs",
    "test:design": "node --test client/test/design-system.test.mjs client/test/ui.test.mjs client/test/leaderboard-ui.test.mjs",
    "test": "npm -w sim test && npm run test:client",
    "sync:runtime": "node tools/sync-muzil-runtime.mjs",
    "check:runtime": "node tools/sync-muzil-runtime.mjs --check",
    "dev": "node tools/dev-serve.mjs",
    "test:muzil": "node --test client/muzil/test/*.test.mjs",
    "test:muzil:browser": "node tools/muzil-browser-smoke.mjs",
    "test:muzil:doom": "node tools/muzil-doom-smoke.mjs",
    "test:muzil:inference": "node tools/muzil-inference-smoke.mjs",
    "test:muzil:mesh": "node tools/muzil-mesh-smoke.mjs",
    "test:muzil:model": "node tools/muzil-model-qualification.mjs",
    "test:muzil:toaster": "node tools/muzil-toaster-smoke.mjs",
    "test:muzil:apps": "node tools/muzil-mini-apps-smoke.mjs",
    "test:muzil:interruptions": "node tools/muzil-interruption-smoke.mjs",
    "test:muzil:evolving": "node tools/muzil-evolving-smoke.mjs",
    "test:muzil:match": "node tools/muzil-match-smoke.mjs",
    "sync:mandate": "node tools/sync-mandate.mjs",
    "deploy:hosting": "firebase deploy --only hosting --project m3ta-ai"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "playwright": "1.58.0"
  },
  "license": "MIT"
}
