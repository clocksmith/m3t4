{
  "name": "@m3t4/plasma-lab",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "smoke": "tsc && node dist/smoke.js",
    "smoke:derived-browser": "node scripts/smoke-derived-browser-n2.cjs",
    "smoke:webrtc-browser": "node scripts/smoke-webrtc-browser-n2.cjs",
    "smoke:webrtc-client-artifact": "node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-replay-verify": "PLASMA_LAB_SMOKE_KERNEL=replay-verify node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-seed-sweep": "PLASMA_LAB_SMOKE_KERNEL=seed-sweep node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-image-tile-infer": "PLASMA_LAB_SMOKE_KERNEL=image-tile-infer node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-microscopy-tile-score": "PLASMA_LAB_SMOKE_KERNEL=microscopy-tile-score node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-exploit-search": "PLASMA_LAB_SMOKE_KERNEL=exploit-search node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-asset-tile-audit": "PLASMA_LAB_SMOKE_KERNEL=asset-tile-audit node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-contact-map-tile": "PLASMA_LAB_SMOKE_KERNEL=contact-map-tile node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-tensor-tile": "PLASMA_LAB_SMOKE_KERNEL=tensor-tile node scripts/smoke-webrtc-client-artifact.cjs",
    "smoke:webrtc-artifact": "node scripts/smoke-webrtc-client-artifact.cjs",
    "start": "tsc && node dist/index.js"
  },
  "dependencies": {
    "@m3t4/sim": "file:../sim",
    "firebase-admin": "^13.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
